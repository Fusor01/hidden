# Single Neon Postgres database (used by both the UI and all API routes).
# Use the pooled connection string. sslmode=require is handled by the driver.
DATABASE_URL=

# 32+ bytes of hex. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ELIG_HMAC_KEY=

# Any long random string; used to AES-256-GCM-encrypt campaign signing keys at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MASTER_KEY=

# Exact origin allowed to make cookie-authenticated requests (no trailing slash).
APP_ORIGIN=https://hidden-sigma-ten.vercel.app
# Set to false only for local http development.
COOKIE_SECURE=true

# Vercel Cron sends "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=

# Optional tuning
# KEY_BITS=3072
# SESSION_TTL_MINUTES=120
# MAX_FAILED_LOGINS=5
# LOCKOUT_MINUTES=15

# The old NEXT_PUBLIC_IDENTITY_API / NEXT_PUBLIC_BALLOT_API overrides are no longer used.

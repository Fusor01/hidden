{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "cd frontend && npm install --no-audit --no-fund",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/.next",
  "crons": [
    {
      "path": "/api/v1/internal/close-expired",
      "schedule": "0 3 * * *"
    }
  ]
}
